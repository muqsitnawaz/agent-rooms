{
  "comment": "Worker runtime: Cloudflare types only. The client and bridge have their own configs because their globals differ.",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/server.ts", "src/protocol.ts"]
}
