{
  "name": "agent-rooms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multiplayer coding agents on Cloudflare Durable Objects",
  "scripts": {
    "build:client": "bun build src/client.ts --outfile public/app.js --minify --target browser",
    "dev": "bun run build:client && wrangler dev",
    "deploy": "bun run build:client && wrangler deploy",
    "bridge": "bun run bridge/bridge.ts",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.bridge.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.38",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "agents": "^0.20.1",
    "ai": "^7.0.62",
    "workers-ai-provider": "^4.0.0",
    "yjs": "^13.6.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2",
    "wrangler": "^4.121.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/muqsitnawaz/agent-rooms"
  }
}
